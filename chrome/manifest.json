{
  "manifest_version": 3,
  "name": "Sidemorphic",
  "version": "0.1.0",
  "description": "Pin any website to a side panel and open it beside the page you're reading. Plus a scratchpad and snippets. Private by default.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Sidemorphic"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Open the Sidemorphic panel"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "clipboardWrite",
    "tabs",
    "declarativeNetRequestWithHostAccess",
    "favicon"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ]
}
